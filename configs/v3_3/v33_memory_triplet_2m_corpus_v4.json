{
  "matrix_name": "v33_memory_triplet_2m_corpus_v4",
  "base": {
    "data_manifest": "data/corpus_v4/shards.txt",
    "streaming_train": true,
    "streaming_eval": true,
    "stream_samples_per_worker": 200000,
    "seq_len": 128,
    "stride": 64,
    "batch_size": 128,
    "max_steps": 3000,
    "max_eval_batches": 16,
    "num_workers": 2,
    "prefetch_factor": 4,
    "seed": 42,
    "device": "cuda",
    "amp": true,
    "d_model": 256,
    "d_z": 256,
    "d_mem": 256,
    "hidden": 512,
    "max_chunks": 128,
    "max_span": 16,
    "chunk_mixer": "delta_lite",
    "dropout": 0.0,
    "tau_cut": 0.65,
    "tau_trans": 0.2,
    "tau_keep": 0.65,
    "strict_masked_source": true,
    "mask_prob": 0.05,
    "mask_span_min": 1,
    "mask_span_max": 8,
    "visible_loss_weight": 0.25,
    "masked_loss_weight": 1.0,
    "length_loss_weight": 0.05,
    "boundary_loss_weight": 0.02,
    "boundary_credit_loss_weight": 0.05,
    "boundary_credit_backbone_weight": 1.0,
    "rate_loss_weight": 0.02,
    "rate_loss": "upper",
    "target_rate": 0.5,
    "coding_rate_loss_weight": 0.0,
    "memory_vector_overlap_loss_weight": 0.0,
    "memory_gate_loss_weight": 0.05,
    "use_backbone": true,
    "backbone_loss_weight": 1.0,
    "active_only_backbone": true,
    "emit_compute_mode": "masked_or_emitted",
    "emit_threshold": 0.5,
    "backbone_hidden": 192,
    "backbone_layers": 2,
    "backbone_nhead": 4,
    "backbone_ffn_dim": 768,
    "detach_backbone_input": true,
    "detach_backbone_keep": true,
    "lr": 0.0003,
    "weight_decay": 0.01,
    "optimizer": "fused_adamw",
    "warmup_steps": 100,
    "grad_clip": 1.0,
    "log_every": 50,
    "ckpt_every": 1000,
    "save_optimizer": false,
    "resume": false
  },
  "experiments": [
    {
      "id": "no_memory_backbone",
      "overrides": {
        "use_memory": false,
        "memory_rank": 0,
        "memory_top_k": 4
      }
    },
    {
      "id": "memory_rank4_causal_backbone",
      "overrides": {
        "use_memory": true,
        "memory_rank": 4,
        "memory_top_k": 4,
        "memory_build_mode": "causal_current",
        "memory_visibility": "past_only"
      }
    },
    {
      "id": "memory_rank4_parallel_no_self_backbone",
      "overrides": {
        "use_memory": true,
        "memory_rank": 4,
        "memory_top_k": 4,
        "memory_build_mode": "parallel_local",
        "memory_visibility": "bidirectional_no_self"
      }
    }
  ]
}
