{
  "matrix_name": "v34_pos_ar_40m_probe",
  "base": {
    "data_path": "data/corpus.txt",
    "streaming_train": true,
    "streaming_eval": true,
    "stream_samples_per_worker": 30000,
    "seq_len": 512,
    "stride": 256,
    "batch_size": 8,
    "max_steps": 1000,
    "max_eval_batches": 8,
    "num_workers": 2,
    "prefetch_factor": 2,
    "seed": 42,
    "device": "cuda",
    "amp": true,
    "d_model": 512,
    "nhead": 8,
    "ffn_dim": 1536,
    "segmentor_layers": 5,
    "interpreter_layers": 3,
    "memory_rank": 4,
    "readout_vectors": 4,
    "ar_hidden": 128,
    "max_chunks": 64,
    "max_span": 128,
    "tau_cut": 0.9,
    "tau_trans": 0.75,
    "boundary_temperature": 0.15,
    "noise_scale": 0.02,
    "mask_prob": 0.05,
    "mask_span_min": 1,
    "mask_span_max": 8,
    "identity_loss_weight": 1.0,
    "completion_loss_weight": 2.0,
    "preserve_loss_weight": 0.5,
    "boundary_loss_weight": 0.02,
    "coding_rate_loss_weight": 0.01,
    "coding_rate_dim": 64,
    "memory_usage_loss_weight": 0.02,
    "memory_usage_min": 0.2,
    "memory_usage_max": 0.5,
    "ar_delta_loss_weight": 0.01,
    "backbone_hidden": 384,
    "backbone_layers": 3,
    "backbone_nhead": 8,
    "backbone_ffn_dim": 1024,
    "optimizer": "fused_adamw",
    "lr": 0.0002,
    "weight_decay": 0.01,
    "warmup_steps": 100,
    "grad_clip": 1.0,
    "log_every": 20
  },
  "experiments": [
    {"id": "pos_off_ar_off", "overrides": {"use_position": false, "use_ar": false}},
    {"id": "pos_on_ar_off",  "overrides": {"use_position": true,  "use_ar": false}},
    {"id": "pos_off_ar_on",  "overrides": {"use_position": false, "use_ar": true}},
    {"id": "pos_on_ar_on",   "overrides": {"use_position": true,  "use_ar": true}}
  ]
}
