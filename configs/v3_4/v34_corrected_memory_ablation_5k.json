{
  "matrix_name": "v34_corrected_memory_ablation_5k",
  "base": {
    "data_path": "data/corpus.txt",
    "streaming_train": true,
    "streaming_eval": true,
    "stream_samples_per_worker": 30000,
    "seq_len": 512,
    "stride": 256,
    "batch_size": 8,
    "max_steps": 5000,
    "max_eval_batches": 16,
    "num_workers": 2,
    "prefetch_factor": 2,
    "seed": 42,
    "device": "cuda",
    "amp": true,
    "d_model": 512,
    "nhead": 8,
    "ffn_dim": 1536,
    "segmentor_layers": 5,
    "interpreter_layers": 3,
    "memory_rank": 4,
    "readout_vectors": 16,
    "ar_hidden": 128,
    "use_position": true,
    "use_ar": true,
    "use_structured_lookup": true,
    "use_boundary_bridge": true,
    "memory_use_position": true,
    "memory_residual_scale": 0.1,
    "boundary_mode": "uniform_budget",
    "boundary_coding_rate_dim": 16,
    "boundary_coding_rate_epsilon": 1.0,
    "boundary_coding_rate_temperature": 0.15,
    "boundary_coding_rate_mode": "l2",
    "boundary_curriculum_switch_step": 3000,
    "boundary_curriculum_transition_steps": 0,
    "boundary_curriculum_mode": "marginal_rate_topk",
    "boundary_curriculum_coding_rate_mode": "l2",
    "fixed_chunk_budget": 0,
    "bytes_per_chunk_budget": 16,
    "use_emit_controller": true,
    "emit_forward_mode": "hard_st",
    "emit_initial_probability": 0.1,
    "max_chunks": 40,
    "max_span": 128,
    "tau_cut": 0.9,
    "tau_trans": 0.75,
    "boundary_temperature": 0.15,
    "noise_scale": 0.02,
    "mask_prob": 0.05,
    "mask_span_min": 1,
    "mask_span_max": 8,
    "identity_loss_weight": 1.0,
    "completion_loss_weight": 2.0,
    "preserve_loss_weight": 0.5,
    "boundary_loss_weight": 0.02,
    "coding_rate_loss_weight": 0.0,
    "coding_rate_dim": 64,
    "memory_usage_loss_weight": 0.0,
    "memory_usage_min": 0.2,
    "memory_usage_max": 0.5,
    "emit_value_loss_weight": 0.1,
    "emit_value_every": 4,
    "emit_rate_value_weight": 0.05,
    "emit_compute_cost_weight": 0.05,
    "emit_value_temperature": 0.25,
    "ar_delta_loss_weight": 0.01,
    "backbone_hidden": 384,
    "backbone_layers": 3,
    "backbone_nhead": 8,
    "backbone_ffn_dim": 1024,
    "optimizer": "fused_adamw",
    "lr": 0.0002,
    "weight_decay": 0.01,
    "warmup_steps": 200,
    "grad_clip": 1.0,
    "log_every": 20,
    "checkpoint_every": 500,
    "milestone_every": 2500,
    "resume": true
  },
  "experiments": [
    {
      "id": "memory_pos_scale01",
      "overrides": {"use_memory": true}
    },
    {
      "id": "no_memory_local",
      "overrides": {"use_memory": false}
    },
    {
      "id": "memory_no_position",
      "overrides": {"use_memory": true, "memory_use_position": false}
    },
    {
      "id": "memory_pos_scale10",
      "overrides": {"use_memory": true, "memory_residual_scale": 1.0}
    }
  ]
}
